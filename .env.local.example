# Firebase Web App configuration.
# Copy this file to `.env.local` and fill in the real values from
# Firebase Console → Project settings → Your apps → (web app) → Config.
#
# `.env.local` is git-ignored (see .gitignore — `*.local`), so your real
# keys are never committed. This `.env.local.example` file IS committed
# as a template for anyone who clones the repo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
