rules_version = '2';

// Security rules for the personal finance dashboard.
//
// Model: every user's data lives under /users/{uid}/...
// A signed-in user can read and write only their own subtree;
// unauthenticated requests are denied; one user cannot read another's data.
//
// All collections (transactions, rules, categories, accounts, settings,
// budgets, etc.) live as subcollections under /users/{uid}.

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied by default.
  }
}
